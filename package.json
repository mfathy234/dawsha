{
  "name": "dawsha",
  "productName": "Dawsha",
  "version": "0.2.1",
  "description": "One window for all your AI coding agents: a grid of readable terminals for Claude Code, Codex CLI and Gemini CLI",
  "homepage": "https://dawsha.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfathy234/dawsha.git"
  },
  "bugs": {
    "url": "https://github.com/mfathy234/dawsha/issues"
  },
  "main": "./out/main/index.js",
  "author": "Mohamed Fathy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "package": "npm run build && node scripts/release-notes.mjs --optional && electron-builder --win --config electron-builder.yml -c.releaseInfo.releaseNotesFile=release-notes.md",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "electron-vite build && playwright test -c playwright.screenshots.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.10.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "png-to-ico": "3.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
