{
  "name": "dawsha",
  "productName": "Dawsha",
  "version": "1.7.6",
  "description": "One window for all your AI coding agents: a grid of readable terminals for Claude Code, Codex CLI and Gemini CLI",
  "homepage": "https://dawsha.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfathy234/dawsha.git"
  },
  "bugs": {
    "url": "https://github.com/mfathy234/dawsha/issues"
  },
  "main": "./out/main/index.js",
  "author": "Mohamed Fathy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:private-remote": "node scripts/private-remote.mjs dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "build:private-remote": "node scripts/private-remote.mjs build",
    "package": "npm run build && node scripts/release-notes.mjs --optional && electron-builder --config electron-builder.yml -c.releaseInfo.releaseNotesFile=release-notes.md",
    "package:private-remote": "node scripts/private-remote.mjs package",
    "package:private-remote:inner": "npm run build && node scripts/release-notes.mjs --optional && electron-builder --config electron-builder.private-remote.yml -c.releaseInfo.releaseNotesFile=release-notes.md",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:private-remote": "node scripts/private-remote.mjs e2e",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "electron-vite build && playwright test -c playwright.screenshots.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "bidi-js": "1.0.3",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "qrcode-generator": "2.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.10.1",
    "@types/ws": "^8.18.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "png-to-ico": "3.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
